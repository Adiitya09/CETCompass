# ==============================================================================
# CETCOMPASS - PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env for local development.
# Configure these variables in your deployment dashboards (Vercel / Render / Supabase).
# NEVER commit actual secrets or credentials to source control.
# ==============================================================================

# ==============================================================================
# 1. DATABASE VARIABLES (Render & Supabase)
# ==============================================================================
# Local development default:
DATABASE_URL=sqlite:///./college_predictor.db

# Production Supabase PostgreSQL:
# Get this from Supabase Dashboard -> Settings -> Database -> Connection string -> URI
# Use 'Transaction' pooler (port 6543) or direct connection (port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or pooler connection:
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ==============================================================================
# 2. BACKEND VARIABLES (Render / Web Service)
# ==============================================================================
ENVIRONMENT=production
LOG_LEVEL=INFO
PORT=8000

# Administrative secret key for managing datasets (/admin routes)
ADMIN_API_KEY=generate_a_secure_random_key_here

# Secret key for JWT signing & session fallback
JWT_SECRET=generate_a_secure_jwt_secret_here

# Allowed origins for CORS (comma-separated or JSON list)
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Canonical frontend production URL
FRONTEND_URL=https://your-frontend.vercel.app

# ==============================================================================
# 3. SUPABASE VARIABLES (Backend Auth Validation)
# ==============================================================================
# Supabase Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase JWT Secret (Project Settings -> API -> JWT Settings -> JWT Secret)
# Used by backend to cryptographically verify user tokens issued by Supabase Auth
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ==============================================================================
# 4. FRONTEND VARIABLES (Vercel / Next.js)
# ==============================================================================
# Base URL for FastAPI backend API endpoints
NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com/api

# Supabase Auth client credentials for frontend browser auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
