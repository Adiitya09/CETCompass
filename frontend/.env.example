# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (Next.js / Vercel)
# ==============================================================================
# Configure these in your Vercel Project Settings -> Environment Variables.

# URL of the deployed FastAPI backend API (include /api prefix)
NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com/api

# Supabase Auth configuration (public anon key is safe for client-side use)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
