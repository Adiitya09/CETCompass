# ==============================================================================
# Git Ignore - College Predictor
# ==============================================================================

# Python bytecode & artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# Testing, typing & linters
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local database files & uploaded staged files
*.db
*.db-journal
*.sqlite
*.sqlite3
college_predictor.db
data/uploads/staged/
backend/app/data/uploads/staged/

# Environment files & secrets
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Node.js & Next.js frontend
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.vercel/
frontend/*.tsbuildinfo
*.tsbuildinfo

# Logs
*.log
pipeline_run.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & IDE
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Scratch & temporary artifacts
scratch/
*.png
!frontend/public/**/*.png
